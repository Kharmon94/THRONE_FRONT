{
  "directoryListing": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/appointments",
      "destination": "/index.html"
    },
    {
      "source": "/appointments/",
      "destination": "/index.html"
    },
    {
      "source": "/newsletter",
      "destination": "/index.html"
    },
    {
      "source": "/newsletter/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css|svg|png|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
