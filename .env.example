# Build-time variables (baked into the public bundle — never put secrets here).
# Backend API base URL, no trailing slash.
VITE_API_URL=http://localhost:3000
# Canonical public site URL (used by in-app links/metadata helpers).
VITE_SITE_URL=https://www.thronetechnology.com
# GA4 measurement ID — leave empty until the GA4 property exists. Nothing is loaded while empty.
VITE_GA4_MEASUREMENT_ID=
